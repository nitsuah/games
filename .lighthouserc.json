{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000"]
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "unused-javascript": ["error", {"maxLength": 3}],
        "total-byte-weight": ["warn", {"maxNumericValue": 5242880}],
        "non-composited-animations": ["warn", {"minScore": 0.5}]
      }
    }
  }
}
