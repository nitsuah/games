# .env.example

# Application
NODE_ENV=development # Environment: development, production, test
PORT=3000          # Port the server listens on

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gamesdb # Connection string for PostgreSQL database

# Authentication & Security
JWT_SECRET=YOUR_JWT_SECRET # Secret key for signing JSON Web Tokens (JWT)
SESSION_SECRET=YOUR_SESSION_SECRET # Secret key for session management

# External APIs
API_KEY=YOUR_API_KEY # API Key for external services (e.g., game data)
ANALYTICS_ID=UA-XXXXX-Y # Google Analytics Tracking ID (optional)

# Runtime Configuration
LOG_LEVEL=info       # Logging level: debug, info, warn, error
DEBUG=true          # Enable debugging mode (true/false)