# .env.example

# External APIs
API_KEY=YOUR_API_KEY # API Key for external services (e.g., game data)
ANALYTICS_ID=UA-XXXXX-Y # Google Analytics Tracking ID (optional)

# Runtime Configuration
LOG_LEVEL=info       # Logging level: debug (verbose, for development), info (general operational messages), warn (potential issues), error (critical problems). See: https://winstonjs.github.io/winston/#logging-levels
DEBUG=false         # Enable debugging mode (true/false)