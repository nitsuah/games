#!/usr/bin/env bash
set -euo pipefail

# Run tests in docker if available
if command -v docker >/dev/null 2>&1; then
	docker run --rm games-test npm run test:ci
elif command -v npm >/dev/null 2>&1; then
	npm --prefix app run test:ci
elif command -v yarn >/dev/null 2>&1; then
	yarn test:ci
elif command -v pnpm >/dev/null 2>&1; then
	pnpm test:ci
elif command -v npx >/dev/null 2>&1; then
	# Try to run the project's test script via npx without forcing an install
	npx --no-install npm --prefix app run test:ci || true
else
	echo "Warning: no npm/yarn/pnpm/npx/docker found in PATH — skipping pre-commit tests." >&2
fi
