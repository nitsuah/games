#!/usr/bin/env bash
set -euo pipefail

# Cross-platform pre-commit hook: try common node package managers, fall back safely.
# This avoids hard failures on environments where `npm` isn't on PATH (e.g. some Windows setups)
if command -v npm >/dev/null 2>&1; then
	npm test
elif command -v yarn >/dev/null 2>&1; then
	yarn test
elif command -v pnpm >/dev/null 2>&1; then
	pnpm test
elif command -v npx >/dev/null 2>&1; then
	# Try to run the project's test script via npx without forcing an install
	npx --no-install npm run test || true
else
	echo "Warning: no npm/yarn/pnpm/npx found in PATH — skipping pre-commit tests." >&2
fi
